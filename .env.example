# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Full DSN takes precedence over individual fields in config.yaml
DB_URL=postgres://postgres:postgres@localhost:5432/app_db?sslmode=disable

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db
DB_SSLMODE=disable

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
AMQP_URL=amqp://guest:guest@localhost:5672/

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ── Migrations ────────────────────────────────────────────────────────────────
MIGRATIONS_DIR=internal/db/migrations
